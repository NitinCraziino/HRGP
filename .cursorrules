{
    "rules": [
        {
            "name": "Development Guidelines Adherence",
            "description": "Maintain coding standards, performance, and modularity as per .development-guidelines.",
            "sequential": true,
            "steps": [
                "Ensure modular, scalable, and maintainable code.",
                "Optimize code for performance and scalability.",
                "Enforce best practices across frontend and backend.",
                "Perform a final verification before project completion.",
                "Verify all implementation steps.",
                "Use memoization for performance optimizations. using useMemo and useCallback and memo",
                "always use zod for validation",
                "always use arrow functions and export the function in the last line of the file if possible as default export",
                "always memoize components using memo, useMemo, useCallback",
                "always use useQuery for fetching data from api though an hook",
                "use Emojis in commit messages and error and toast messages"
            ]
        },
        {
            "name": "Git Commit Messages",
            "description": "Always write clear and concise git commit messages.",
            "sequential": true,
            "steps": [
                "Write a commit message explaining the main changes made only the overview of the changes.",
                "Use present tense in the commit message."
            ]
        }
    ]
}